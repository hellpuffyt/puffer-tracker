# Copy to .env.local (git-ignored). Only FINNHUB_API_KEY is needed for the dashboard, search and stock pages.

# Finnhub market data (https://finnhub.io). Server-side only; prefer this over the NEXT_PUBLIC_ variant,
# which Next.js would inline into client bundles if it were ever imported from client code.
FINNHUB_API_KEY=
# NEXT_PUBLIC_FINNHUB_API_KEY=

# MongoDB (used by the Better Auth helpers, the watchlist lookup and the daily e-mail job)
MONGODB_URI=

# Better Auth (helpers only; the sign-in/sign-up pages are not in this repository)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Inngest + Gemini + Gmail for the welcome / daily news e-mails
GEMINI_API_KEY=
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
# Required by Inngest in production (https://www.inngest.com/docs)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
